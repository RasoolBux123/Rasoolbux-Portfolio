generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}
model Project {
  id          Int      @id @default(autoincrement())
  title       String
  description String
  tech        String   // "Next.js,FastAPI" ki tarah save hoga (SQLite me array nahi hota)
  color1      String
  color2      String
  imageVer    Int      @default(0) // 0 = no image, bumps on every upload
  liveUrl     String   @default("")
  githubUrl   String   @default("")
  details     String   @default("")
  createdAt   DateTime @default(now())
}

model Admin {
  id           Int      @id @default(autoincrement())
  email        String   @unique
  passwordHash String
  createdAt    DateTime @default(now())
}

model Message {
  id        Int      @id @default(autoincrement())
  name      String
  email     String
  message   String
  read      Boolean  @default(false)
  createdAt DateTime @default(now())
}

model Profile {
  id       Int    @id @default(1) // only one row, always id 1
  role     String
  location String
  about    String
  email    String
  photoVer Int    @default(0) // 0 = use the default photo
  cvVer    Int    @default(0) // 0 = use the default CV
  github   String
  linkedin String
  whatsapp String @default("")
  nowText  String    @default("")
  nowAt    DateTime? // when the Now text last changed
}

model SkillGroup {
  id       Int    @id @default(autoincrement())
  name     String
  items    String // "Next.js,React,TypeScript"
  position Int    // order on the page
}

model Experience {
  id       Int    @id @default(autoincrement())
  year     String
  title    String
  detail   String
  position Int
  current  Boolean @default(false) // shows the green "Current" badge
  tech     String  @default("")    // "Next.js,FastAPI"
}

model Visit {
  id        Int      @id @default(autoincrement())
  visitorId String
  path      String
  referrer  String   @default("")
  country   String   @default("")
  device    String   @default("")
  createdAt DateTime @default(now())

  @@index([createdAt])
}

// uploaded files (CV, profile photo, project images) stored in the database
model File {
  key       String   @id // "cv", "photo" or "project-3"
  mime      String
  data      Bytes
  size      Int
  updatedAt DateTime @updatedAt
}

model Education {
  id       Int    @id @default(autoincrement())
  degree   String
  school   String
  period   String @default("")
  detail   String @default("")
  position Int
}

model Certificate {
  id       Int    @id @default(autoincrement())
  title    String
  issuer   String @default("")
  year     String @default("")
  imageVer Int    @default(0) // 0 = no image uploaded
  position Int
}