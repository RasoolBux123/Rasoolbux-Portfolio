generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}
model Project {
  id          Int      @id @default(autoincrement())
  title       String
  description String
  tech        String   // "Next.js,FastAPI" ki tarah save hoga (SQLite me array nahi hota)
  color1      String
  color2      String
  liveUrl     String   @default("")
  githubUrl   String   @default("")
  details     String   @default("")
  createdAt   DateTime @default(now())
}

model Admin {
  id           Int      @id @default(autoincrement())
  email        String   @unique
  passwordHash String
  createdAt    DateTime @default(now())
}

model Message {
  id        Int      @id @default(autoincrement())
  name      String
  email     String
  message   String
  read      Boolean  @default(false)
  createdAt DateTime @default(now())
}

model Profile {
  id       Int    @id @default(1) // only one row, always id 1
  role     String
  location String
  about    String
  email    String
  github   String
  linkedin String
  whatsapp String @default("")
}

model SkillGroup {
  id       Int    @id @default(autoincrement())
  name     String
  items    String // "Next.js,React,TypeScript"
  position Int    // order on the page
}

model Experience {
  id       Int    @id @default(autoincrement())
  year     String
  title    String
  detail   String
  position Int
}

model Visit {
  id        Int      @id @default(autoincrement())
  visitorId String
  path      String
  referrer  String   @default("")
  country   String   @default("")
  device    String   @default("")
  createdAt DateTime @default(now())

  @@index([createdAt])
}